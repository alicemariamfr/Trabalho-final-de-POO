import java.time.LocalDate;
import java.util.ArrayList;
import java.util.List;

public class ListaEventos implements CadastroEvento{
    private List<Evento> listaEventos;
    private int contadorId = 1;  // atribuirá o id de cada evento

    public ListaEventos() {
        this.listaEventos = new ArrayList<>();
    }

    @Override
    public void adicionarEvento(Evento evento) throws ExcecaoDadosInvalidos {
        evento.validadorBase();

        if (dataJaReservada(evento.getData())) {
            throw new ExcecaoDadosInvalidos("Já existe um evento cadastrado nesta data");
        }

        if (eventoExiste(evento.getNome(), evento.getData())) {
            throw new ExcecaoDadosInvalidos("Este evento já foi cadastrado anteriormente.");
        }

        evento.setIdEvento(String.valueOf(contadorId++));
        listaEventos.add(evento);
    }

    @Override
    public boolean removerEvento(Evento evento) {
        // Remove pelo ID para garantir precisão
        return listaEventos.removeIf(e -> e.getIdEvento().equals(evento.getIdEvento()));
    }

    @Override
    public void atualizarDadosEvento(Evento eventoAtualizado) {
        for (int i = 0; i < listaEventos.size(); i++) {
            Evento eventoExistente = listaEventos.get(i);

            // 1. Localiza o evento original pelo ID
            if (eventoExistente.getIdEvento().equals(eventoAtualizado.getIdEvento())) {
                
                // 2. Valida as regras básicas
                eventoAtualizado.validadorBase();

                // 3. Verifica conflito de data
                // Se a data mudou, precisamos garantir que o novo dia não esteja ocupado
                if (!eventoExistente.getData().equals(eventoAtualizado.getData())) {
                    if (dataJaReservada(eventoAtualizado.getData())) {
                        throw new ExcecaoDadosInvalidos("Não é possível alterar para esta data: o dia " 
                                                        + eventoAtualizado.getData() + " já está ocupado.");
                    }
                }
                // 4. Se passou nas validações, atualiza na lista
                listaEventos.set(i, eventoAtualizado);
                return;
            }
    }
    // Caso o ID passado não exista na lista
    throw new ExcecaoDadosInvalidos("Evento com ID " + eventoAtualizado.getIdEvento() + " não encontrado.");
}
   @Override
   public Evento buscarEvento(Evento evento) {
        for (Evento e : listaEventos) {
            if (e.getIdEvento().equals(evento.getIdEvento())) {
                return e;
            }
        }
        return null;
    }

    
    @Override
    public Evento mostrarEventoPorData(LocalDate data) {
        for (Evento e : listaEventos) {
            if (e.getData().equals(data)) {
                return e;
            }
        }
        return null;
    }

    @Override
    public List<Evento> listarEventosPorTipo(TipoEvento tipo) {
        List<Evento> eventosPorTipo = new ArrayList<>();
        for (Evento e : listaEventos) {
            if (e.getTipo() == tipo) {
                eventosPorTipo.add(e);
            }
        }
        return eventosPorTipo;
    }
    
    @Override
    public List<Evento> listarEventosPorCliente(Cliente cliente) {
        List<Evento> resultado = new ArrayList<>();

        for (Evento e : listaEventos) {
            if (e.getCliente().equals(cliente)) {
                resultado.add(e);
            }
        }
        return resultado;
    }
    
    @Override
    public List<Evento> listarEventos() {
        return new ArrayList<>(listaEventos); // evita exposição direta da lista
    }

    @Override
    public double calcularTotalMensal(int mes, int ano) {
        double total = 0.0;

        for (Evento e : listaEventos) {
            if (e.getData().getMonthValue() == mes &&
                e.getData().getYear() == ano) {

                total += e.calcularOrcamento();
            }
        }
        return total;
    }

    @Override
    public double calcularPagamentoPorCliente(Cliente cliente) {

        double total = 0.0;

        List<Evento> eventosDoCliente = listarEventosPorCliente(cliente);

        for (Evento e : eventosDoCliente) {
            total += e.calcularOrcamento();
        }

        return total;
    }

    @Override
    public boolean eventoExiste(String nome, LocalDate data) {
        for (Evento e : listaEventos) {
            if (e.getNome().equalsIgnoreCase(nome) && e.getData().equals(data)) {
                return true;
            }
        }
        return false;
    }

    @Override
    public boolean eventoExiste(Evento evento) {
        return buscarEvento(evento) != null;
    }

    private boolean dataJaReservada(LocalDate data) {
        for (Evento e : listaEventos) {
            if (e.getData().equals(data)) {
                return true;
            }
        }

        return false;
    }

    @Override
    public int totalEventos() {
        return listaEventos.size();
    }

}
